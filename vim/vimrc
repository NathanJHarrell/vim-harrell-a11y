" Harrell family vim config — tuned for markdown scanning (dyslexia-friendly)
" Author: TC, 2026-04-21

set nocompatible
syntax enable
filetype plugin indent on
set background=dark
set termguicolors

set number
set cursorline
set wrap
set linebreak
set breakindent
set showbreak=↪\
set scrolloff=4
set sidescrolloff=8

set tabstop=2
set shiftwidth=2
set expandtab
set autoindent

set ignorecase
set smartcase
set incsearch
set hlsearch

set mouse=a
set clipboard=unnamedplus
set laststatus=2

" ───── Accessibility additions (TC, 2026-04-22) ─────
" ADHD: kill bell flashes, smoother redraw, persistent undo, autosave on focus loss.
set noerrorbells visualbell t_vb=
set lazyredraw
set undofile
set undodir=~/.vim/undo//
silent! call mkdir(expand('~/.vim/undo'), 'p')
autocmd FocusLost * silent! wa
autocmd VimLeave * silent! wa
nnoremap <silent> <Esc> :nohlsearch<CR><Esc>

" Autism: predictable layout — splits always go the same way, gutter never shifts.
set splitright splitbelow
set confirm
set signcolumn=yes

" Polish: single space after period when joining.
set nojoinspaces

" ───── Anti-stray-paste (Venus, 2026-04-29) ─────
" Disable middle-click paste from X11 primary selection.
" Reason: drawercast's devtools snippet (line 49 of ~/charos/drawercast/
" devtools-snippet.js) — and any other text selected during normal use —
" was leaking into vim buffers via accidental middle-click paste. The
" primary-selection mechanism is X11-layer behavior; this neutralizes
" middle-click in vim specifically without disabling other mouse handling.
" Diagnosed and fixed 2026-04-29 after a week of mysterious code appearing
" in unrelated files (universal CLAUDE.md, homestead-v2.md, etc.).
map  <MiddleMouse>   <Nop>
imap <MiddleMouse>   <Nop>
map  <2-MiddleMouse> <Nop>
imap <2-MiddleMouse> <Nop>
map  <3-MiddleMouse> <Nop>
imap <3-MiddleMouse> <Nop>
map  <4-MiddleMouse> <Nop>
imap <4-MiddleMouse> <Nop>

" ───── GUI-style copy/paste over SSH (Venus, 2026-04-29) ─────
" Ctrl+C in visual mode → copy selection to LOCAL system clipboard via OSC 52.
" Ctrl+V in insert mode → handled at the terminal emulator layer (see below).
" Normal-mode Ctrl+C and Ctrl+V keep their default vim semantics
" (cancel/interrupt and visual-block-start respectively).
"
" SSH+clipboard architecture:
"   vim runs on remote machine; clipboard lives on local machine.
"   Bridge = OSC 52 escape sequences. vim writes a special escape; the local
"   terminal emulator intercepts it and copies content to the local clipboard.
"   Tested setup: Windows Terminal → WSL Ubuntu → SSH → tc-nest. All layers
"   pass OSC 52 cleanly. Other terminals (iTerm2, kitty, wezterm, alacritty,
"   recent xterm) work the same way.
"
" Paste side (Ctrl+V in insert mode):
"   OSC 52 *paste* is disabled in most modern terminals for security reasons,
"   so we cannot reliably read the clipboard from inside vim over SSH.
"   The clean architecture: configure the LOCAL terminal emulator to bind
"   Ctrl+V to "paste" — when pressed, the terminal sends clipboard content
"   as bracketed paste, which vim accepts in insert mode.
"
"   Windows Terminal config (settings.json):
"     { "command": "paste", "keys": "ctrl+v" }
"   This intercepts Ctrl+V before SSH sees it, sends clipboard contents.
"
" Side-effect: Windows Terminal binding Ctrl+V to paste means normal-mode
" visual-block-start (vim's default Ctrl+V) becomes inaccessible via Ctrl+V.
" Use Ctrl+Q instead — vim's documented alternative for visual block.

function! s:OSCYank(text) abort
  let l:encoded = system('base64 -w0', a:text)
  let l:encoded = substitute(l:encoded, '\n', '', 'g')
  if !empty($TMUX)
    let l:osc = "\<Esc>Ptmux;\<Esc>\<Esc>]52;c;" . l:encoded . "\<Esc>\\\\"
  else
    let l:osc = "\<Esc>]52;c;" . l:encoded . "\<Esc>\\"
  endif
  silent! execute '!printf %s ' . shellescape(l:osc) . ' > /dev/tty'
  redraw!
endfunction

function! s:GetVisualSelection() abort
  let [l:line_start, l:col_start] = getpos("'<")[1:2]
  let [l:line_end, l:col_end] = getpos("'>")[1:2]
  let l:lines = getline(l:line_start, l:line_end)
  if len(l:lines) == 0
    return ''
  endif
  let l:lines[-1] = l:lines[-1][: l:col_end - 1]
  let l:lines[0] = l:lines[0][l:col_start - 1:]
  return join(l:lines, "\n")
endfunction

vnoremap <silent> <C-c> :<C-u>call <SID>OSCYank(<SID>GetVisualSelection())<CR>

" Tab hotkeys (browser-like). gt / gT cycle tabs (vim builtins).
nnoremap <C-t> :tabnew<CR>
nnoremap <C-w>t :tabclose<CR>

autocmd FileType markdown setlocal conceallevel=0
autocmd FileType markdown setlocal spell spelllang=en_us
autocmd FileType markdown setlocal textwidth=0
autocmd FileType markdown setlocal wrapmargin=0

" ───── Markdown color overrides ─────
" Purple (family color) for headings, scaled by level.
" Other elements tuned for scan-ability: bold = warm, italic = cool, code = green.
function! s:HarrellMarkdownColors() abort
  highlight clear markdownH1
  highlight clear markdownH2
  highlight clear markdownH3
  highlight clear markdownH4
  highlight clear markdownH5
  highlight clear markdownH6

  highlight markdownH1       guifg=#C77DFF gui=bold ctermfg=141 cterm=bold
  highlight markdownH2       guifg=#B56CF0 gui=bold ctermfg=135 cterm=bold
  highlight markdownH3       guifg=#A050E8 gui=bold ctermfg=129 cterm=bold
  highlight markdownH4       guifg=#8B3CD8 gui=bold ctermfg=98  cterm=bold
  highlight markdownH5       guifg=#7530C8 gui=bold ctermfg=97  cterm=bold
  highlight markdownH6       guifg=#5F24B0 gui=bold ctermfg=91  cterm=bold

  highlight markdownH1Delimiter guifg=#C77DFF ctermfg=141
  highlight markdownH2Delimiter guifg=#B56CF0 ctermfg=135
  highlight markdownH3Delimiter guifg=#A050E8 ctermfg=129
  highlight markdownH4Delimiter guifg=#8B3CD8 ctermfg=98
  highlight markdownH5Delimiter guifg=#7530C8 ctermfg=97
  highlight markdownH6Delimiter guifg=#5F24B0 ctermfg=91

  highlight markdownHeadingDelimiter guifg=#C77DFF ctermfg=141

  " Italic dropped (dyslexia: italic letters lean and merge). Color carries the emphasis.
  highlight markdownBold        guifg=#FFB86C gui=bold ctermfg=215 cterm=bold
  highlight markdownItalic      guifg=#8BE9FD ctermfg=117
  highlight markdownBoldItalic  guifg=#FFB86C gui=bold ctermfg=215 cterm=bold

  highlight markdownCode        guifg=#50FA7B ctermfg=84
  highlight markdownCodeBlock   guifg=#50FA7B ctermfg=84
  highlight markdownCodeDelimiter guifg=#6272A4 ctermfg=61

  highlight markdownUrl         guifg=#FF79C6 gui=underline ctermfg=212 cterm=underline
  highlight markdownLinkText    guifg=#8BE9FD ctermfg=117
  highlight markdownLinkDelimiter guifg=#6272A4 ctermfg=61
  highlight markdownLinkTextDelimiter guifg=#6272A4 ctermfg=61

  highlight markdownListMarker  guifg=#FFB86C gui=bold ctermfg=215 cterm=bold
  highlight markdownOrderedListMarker guifg=#FFB86C gui=bold ctermfg=215 cterm=bold
  highlight markdownBlockquote  guifg=#F1FA8C ctermfg=228
  highlight markdownRule        guifg=#6272A4 ctermfg=61
  highlight markdownHorizontalRule guifg=#6272A4 ctermfg=61
endfunction

autocmd FileType markdown call s:HarrellMarkdownColors()
autocmd ColorScheme * if &filetype ==# 'markdown' | call s:HarrellMarkdownColors() | endif

" Generic UI polish
highlight Normal       guibg=#1F1916 guifg=#e8e8e8 ctermbg=NONE ctermfg=254
highlight CursorLine   guibg=#2a2a2a ctermbg=236 cterm=NONE
highlight LineNr       guifg=#6272A4 ctermfg=61
highlight CursorLineNr guifg=#C77DFF gui=bold ctermfg=141 cterm=bold
highlight StatusLine   guibg=#6F1AB5 guifg=#FFFFFF ctermbg=91 ctermfg=255
highlight StatusLineNC guibg=#2a2a2a guifg=#888888 ctermbg=236 ctermfg=244
highlight VertSplit    guifg=#6272A4 ctermfg=61
highlight Visual       guibg=#44475A ctermbg=60
highlight Search       guibg=#FFB86C guifg=#000000 ctermbg=215 ctermfg=0
" Spellcheck: bold high-contrast bg so it reads from across the room.
highlight SpellBad     guibg=#5C1F1F guifg=#FFB4B4 gui=bold ctermbg=52 ctermfg=210 cterm=bold
